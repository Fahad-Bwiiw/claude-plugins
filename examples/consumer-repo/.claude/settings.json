{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "bwiiw-agents": {
      "source": {
        "source": "github",
        "repo": "Fahad-Bwiiw/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "agentkit@bwiiw-agents": true
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format --check:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pip-audit:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm vitest run:*)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm fmt:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm exec semgrep:*)",
      "Bash(gitleaks detect:*)",
      "Bash(checkov:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./backend/.env)",
      "Read(./frontend/.env)"
    ]
  }
}
